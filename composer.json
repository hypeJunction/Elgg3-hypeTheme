{
    "name": "hypejunction/hypetheme",
    "version": "4.0.0",
    "type": "elgg-plugin",
    "description": "Theme editor",
    "homepage": "https://github.com/hypeJunction/Elgg3-hypeTheme",
    "keywords": [
        "elgg",
        "plugin",
        "theme"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Ismayil Khayredinov",
            "email": "ismayil.khayredinov@gmail.com"
        }
    ],
    "extra": {
        "installer-name": "hypeTheme",
        "elgg-plugin": {
            "id": "hypetheme"
        }
    },
    "require": {
        "composer/installers": "^2.0",
        "php": ">=8.2",
        "elgg/elgg": "^5.0"
    },
    "autoload": {
        "psr-0": {
            "": "classes/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
